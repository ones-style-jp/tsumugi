{
  "crons": [
    {
      "path": "/api/brevo-keepalive",
      "schedule": "0 21 1 */2 *"
    },
    {
      "path": "/api/push",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/backup-photos",
      "schedule": "30 18 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw-push.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/pdf.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/state-cas.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/backup-photos.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}